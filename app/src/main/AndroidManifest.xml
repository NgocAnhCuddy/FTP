<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Mạng -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Bắt buộc để nhận gói tin phản hồi SSDP multicast khi dò TV/loa DLNA trong LAN -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Camera: quét mã QR để kết nối FTP/SFTP/SMB nhanh -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Lưu trữ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Foreground service để FTP server chạy nền ổn định -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Cần để hiện hộp thoại xin OneUI (Samsung)/HyperOS (Xiaomi) miễn trừ khỏi trình quản lý
         pin — cả 2 hệ thống đều có cơ chế "Tối ưu hoá pin" RIÊNG, mạnh tay hơn nhiều so với
         Android gốc (AOSP), tự động kill các service nền (kể cả foreground service đã khai
         đúng foregroundServiceType) sau vài phút nếu app không nằm trong danh sách miễn trừ —
         đây là nguyên nhân phổ biến khiến máy chủ FTP/SFTP/Media Cast tự dừng giữa chừng trên 2
         hãng này dù hoạt động ổn định trên Android gốc/Pixel. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Quản lý lưu trữ: "Ứng dụng không dùng" cần đọc usage stats, gỡ cài đặt qua Intent chuẩn -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".MyFileApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.MyFile"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyFile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn khoá app (PIN + sinh trắc học): excludeFromRecents để không lộ giao diện nhập
             PIN trong app switcher/recent apps; launchMode singleTask để tránh xếp chồng nhiều
             instance nếu người dùng bấm mở app liên tục lúc đang bị khoá. -->
        <activity
            android:name=".AppLockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.MyFile" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyFile" />

        <activity
            android:name=".FtpConnectionActivity"
            android:exported="false"
            android:label="@string/title_ftp_client" />

        <activity
            android:name=".FileBrowserActivity"
            android:exported="false"
            android:label="@string/title_file_browser" />

        <activity
            android:name=".CategoryFilesActivity"
            android:exported="false" />

        <activity
            android:name=".FolderPickerActivity"
            android:exported="false" />

        <activity
            android:name=".ArchivePreviewActivity"
            android:exported="false" />

        <activity
            android:name=".MediaViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.MyFile.MediaViewer" />

        <activity
            android:name=".CastToTvActivity"
            android:exported="false"
            android:label="@string/title_cast_to_tv" />

        <activity
            android:name=".RemoteServersActivity"
            android:exported="false"
            android:label="@string/title_remote_servers" />

        <activity
            android:name=".AudioPlayerActivity"
            android:exported="false"
            android:label="@string/title_audio_player" />

        <activity
            android:name=".TrashActivity"
            android:exported="false"
            android:label="@string/title_trash" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:label="@string/title_search" />

        <activity
            android:name=".StorageManagerActivity"
            android:exported="false"
            android:label="@string/title_storage_manager" />

        <activity
            android:name=".DuplicateFilesActivity"
            android:exported="false"
            android:label="@string/storage_action_duplicate" />

        <activity
            android:name=".UnusedAppsActivity"
            android:exported="false"
            android:label="@string/storage_action_unused_apps" />

        <activity
            android:name=".LargeFilesActivity"
            android:exported="false"
            android:label="@string/storage_action_large" />

        <activity
            android:name=".CloudBrowserActivity"
            android:exported="false"
            android:label="@string/title_cloud_browser" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="@string/title_logs" />

        <activity
            android:name=".QrScannerActivity"
            android:exported="false"
            android:label="@string/title_qr_scanner"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HtmlViewerActivity"
            android:exported="true"
            android:label="@string/title_html_viewer">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="text/html" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PdfViewerActivity"
            android:exported="true"
            android:label="@string/title_pdf_viewer">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DocxViewerActivity"
            android:exported="true"
            android:label="@string/title_docx_viewer">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            </intent-filter>
        </activity>

        <activity
            android:name=".XlsxViewerActivity"
            android:exported="true"
            android:label="@string/title_xlsx_viewer">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CodeEditorActivity"
            android:exported="false"
            android:label="@string/title_code_editor"
            android:windowSoftInputMode="adjustResize" />

        <!-- Redirect activity cho OAuth2 (Box / Dropbox) qua AppAuth -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.myfile.ui.oauth" />
            </intent-filter>
        </activity>

        <service
            android:name=".server.FtpServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- HTTP server phát file qua LAN cho TV/điện thoại khác (mở link bằng trình duyệt/VLC),
             và làm nguồn để DLNA cast trỏ TV về lấy dữ liệu. -->
        <service
            android:name=".server.MediaCastService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Player audio chạy nền kiểu VLC: tắt màn hình vẫn phát, có notification điều khiển. -->
        <service
            android:name=".media.AudioPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Vai trò UPnP MediaRenderer: máy chủ HTTP/SOAP (AVTransport + RenderingControl) +
             SSDP để thiết bị khác (BubbleUPnP, TV, điện thoại khác) "Phát tới" MyFile Manager. -->
        <service
            android:name=".dlna.RendererCastService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ExoPlayer thực sự phát media nhận được qua RendererCastService, chạy nền kiểu VLC. -->
        <service
            android:name=".dlna.RendererPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
