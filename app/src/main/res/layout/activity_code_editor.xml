<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#252526"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@android:color/white"
        app:menu="@menu/menu_code_editor" />

    <!-- Thanh tìm kiếm: ẩn theo mặc định, hiện khi bấm "Tìm kiếm" trên toolbar -->
    <LinearLayout
        android:id="@+id/layout_find_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#252526"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_find"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/hint_find"
            android:textColorHint="#8A8A8A"
            android:textColor="@android:color/white"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_find_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="#8A8A8A"
            android:textSize="12sp"
            tools:text="1/5" />

        <ImageButton
            android:id="@+id/btn_find_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_up"
            app:tint="@android:color/white"
            android:contentDescription="@string/btn_find_prev" />

        <ImageButton
            android:id="@+id/btn_find_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:rotation="180"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_up"
            app:tint="@android:color/white"
            android:contentDescription="@string/btn_find_next" />

        <ImageButton
            android:id="@+id/btn_find_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_clear"
            app:tint="@android:color/white"
            android:contentDescription="@string/cancel" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ScrollView DỌC duy nhất bọc cả 2 cột (số dòng + nội dung) trong 1 hàng ngang,
             để chúng LUÔN cuộn cùng lúc — không cần đồng bộ 2 scroll riêng bằng code. -->
        <ScrollView
            android:id="@+id/scroll_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:overScrollMode="always">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Cột số dòng: căn đúng theo dòng LOGIC (mỗi \n = 1 số). EditText bên cạnh
                     KHÔNG tự wrap mà cuộn ngang riêng, để 1 dòng logic luôn = 1 dòng hiển thị,
                     đảm bảo số dòng không bao giờ lệch so với nội dung thật của file. -->
                <TextView
                    android:id="@+id/tv_line_numbers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="36dp"
                    android:background="#252526"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="240dp"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#6E7681"
                    android:gravity="end|top"
                    tools:text="1\n2\n3" />

                <HorizontalScrollView
                    android:id="@+id/hsv_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="horizontal"
                    android:overScrollMode="always">

                    <EditText
                        android:id="@+id/et_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:paddingStart="12dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="240dp"
                        android:fontFamily="monospace"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#D4D4D4"
                        android:textColorHint="#6E7681"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:scrollHorizontally="true"
                        android:overScrollMode="never" />
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Thanh trạng thái dưới cùng: dòng/cột hiện tại + tên file -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#252526"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_cursor_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#8A8A8A"
            android:textSize="12sp"
            tools:text="Dòng 1, Cột 1" />

        <TextView
            android:id="@+id/tv_file_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A8A8A"
            android:textSize="12sp"
            tools:text="script.js" />
    </LinearLayout>

</LinearLayout>
