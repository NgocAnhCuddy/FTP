<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- FTP thường (không TLS) chạy trên LAN nên cần cho phép cleartext -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
